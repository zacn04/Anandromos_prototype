        {
          "text": "{a}x − {b} = {a*x - b}",
          "note": "",
          "prereqSubtopicIds": []
        },
        {
          "text": "{a}x = {a*x - b} + {b}",
          "note": "−{b} crosses the =, so it becomes +{b}",
